{
  "name": "rpg-game",
  "version": "1.0.0",
  "description": "Учебный проект RPG-game с настройкой Babel и ESLint",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "set ESLINT_USE_FLAT_CONFIG=true&& eslint . --config eslintrc.config.mjs",
    "test": "jest",
    "coverage": "jest --coverage",
    "preshow:dist": "npm run build",
    "show:dist": "live-server dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Petroivch/bhebdps-ojs.git"
  },
  "keywords": [
    "rpg",
    "game",
    "babel",
    "eslint"
  ],
  "author": "p.tikhmenev",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/eslintrc": "^2.1.4",
    "@eslint/js": "^8.57.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "mini-css-extract-plugin": "^2.9.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "dependencies": {
    "core-js": "^3.42.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/js/weapons/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    },
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}
